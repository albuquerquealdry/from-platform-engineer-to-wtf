---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { url } from '../../lib/utils';

const entries = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const items = entries.map((e) => ({
  href: url(`/notes/${e.id}`),
  title: e.data.title,
  date: e.data.date,
  description: e.data.description,
  meta: [e.data.category],
}));
---

<Base
  title="Notes"
  description="Short field notes: a bug, a gotcha, a thing learned the hard way. Raw material for future entries."
>
  <div class="page">
    <div class="section-head">
      <h2>Notes</h2>
      <span class="aside">{entries.length === 0 ? 'Empty' : `${entries.length} · field notes`}</span>
    </div>
    <p class="lede" style="margin-bottom:3rem">
      Short, dated, specific. A bug and its cause, a gotcha and its fix. Entries graduate into
      full logs when they earn it.
    </p>
    <EntryList items={items} empty="No notes published yet." />
  </div>
</Base>
