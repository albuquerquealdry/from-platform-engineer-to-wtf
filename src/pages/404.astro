---
import Base from '../layouts/Base.astro';
import { url } from '../lib/utils';
import Leleu from '../components/Leleu.astro';
---

<Base title="404" description="This page does not exist.">
  <div class="page">
    <div class="section-head">
      <h2>404</h2>
      <span class="aside">Not found</span>
    </div>
    <div class="masthead">
      <div class="masthead__text">
        <p class="lede">
          This one is on me, not on you. The page isn’t here — or isn’t here yet.
        </p>
        <p style="margin-top:2rem">
          <a class="text-link" href={url("/logs")}>← Back to the migration logs</a>
        </p>
      </div>
      <Leleu class="masthead__leleu" width="15rem" mood="confused" />
    </div>
  </div>
</Base>
