---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';

const entries = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const items = entries.map((e) => ({
  href: `/projects/${e.id}`,
  title: e.data.title,
  date: e.data.date,
  description: e.data.description,
  meta: [e.data.status.toUpperCase(), e.data.category],
}));
---

<Base
  title="Projects"
  description="Things I built to understand something — running, building, broken or archived."
>
  <div class="page">
    <div class="section-head">
      <h2>Projects</h2>
      <span class="aside">{entries.length} · build to understand</span>
    </div>
    <p class="lede" style="margin-bottom:3rem">
      Small systems built to answer a specific question. Some still run. Some taught me something
      and were deleted.
    </p>
    <EntryList items={items} empty="No projects published yet." />
  </div>
</Base>
