---
import ThemeToggle from './ThemeToggle.astro';
import { url } from '../lib/utils';

const path = Astro.url.pathname.replace(/\/+$/, '');
const isActive = (href: string) => {
  const target = url(href).replace(/\/+$/, '');
  return path === target || path.startsWith(target + '/');
};

const nav = [
  { href: '/logs', label: 'Logs' },
  { href: '/projects', label: 'Projects' },
  { href: '/notes', label: 'Notes' },
  { href: '/about', label: 'About' },
];
---

<header class="site-header">
  <div class="page site-header__inner">
    <a class="site-header__mark" href={url('/')}>
      Platform Engineer <span aria-hidden="true">→</span> <span class="wtf">WTF</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
