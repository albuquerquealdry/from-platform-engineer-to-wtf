---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import CodeCopy from '../components/CodeCopy.astro';
import { SITE } from '../config.mjs';
import { formatDate, isoDate, slugifyCategory, url } from '../lib/utils';

interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  tags?: string[];
  headings: MarkdownHeading[];
  minutes: number;
  /** e.g. "001" — rendered above the title. */
  number?: string;
  /** e.g. "Migration log #001" */
  stamp?: string;
  prev?: { href: string; title: string } | null;
  next?: { href: string; title: string } | null;
}

const {
  title,
  description,
  date,
  category,
  tags = [],
  headings,
  minutes,
  number,
  stamp,
  prev,
  next,
} = Astro.props;

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: isoDate(date),
  author: { '@type': 'Person', name: SITE.author },
  url: new URL(Astro.url.pathname, Astro.site).href,
  isPartOf: { '@type': 'Blog', name: SITE.title, url: SITE.url },
};
---

<Base title={title} description={description} type="article" publishedAt={date}>
  <article class="page">
    <header class="article-head">
      {number && <p class="article-head__num">{number}</p>}
      <h1 class="article-head__title">{title}</h1>
      <div class="article-head__meta">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        <span class="sep" aria-hidden="true">·</span>
        <a class="text-link" href={url(`/category/${slugifyCategory(category)}`)}>{category}</a>
        <span class="sep" aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </div>
      {stamp && <p class="article-head__stamp">{stamp}</p>}
    </header>

    <div class="article-layout">
      <div class="prose">
        <slot />
      </div>

      {
        toc.length > 2 && (
          <nav class="toc" aria-label="On this page">
            <p class="toc__title">On this page</p>
            <ol>
              {toc.map((h) => (
                <li data-depth={h.depth}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </div>

    {
      tags.length > 0 && (
        <div class="tags" style="margin-top:3rem">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }

    {
      (prev || next) && (
        <nav class="prev-next" aria-label="Adjacent entries">
          {prev && (
            <a href={prev.href}>
              <span class="dir">← Previous</span>
              {prev.title}
            </a>
          )}
          {next && (
            <a class="next" href={next.href}>
              <span class="dir">Next →</span>
              {next.title}
            </a>
          )}
        </nav>
      )
    }
  </article>

  <CodeCopy />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
</Base>
